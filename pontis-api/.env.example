APP_NAME=Pontis
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend.up.railway.app

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://your-frontend.up.railway.app

SANCTUM_STATEFUL_DOMAINS=

# Initial superadmin account, created by SuperAdminSeeder.
# If SUPERADMIN_PASSWORD is left empty a random password is generated and printed
# once during seeding. Never commit real credentials here.
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=
